# Copiar e preencher SOMENTE no Streamlit Cloud Settings > Secrets.
# NÃO salvar uma cópia com os valores no GitHub ou no chat.

# PAT fine-grained apenas com Actions: Read para o repositório privado.
GITHUB_SNAPSHOT_TOKEN = ""

# Chave pública Ed25519 BASE64URL (32 bytes), copiada e conferida
# INDEPENDENTEMENTE com o apêndice B do manual JWS OFICIAL do TSE.
# Nunca usar chave embutida em arquivo JWS, nem confiar em cópia não auditada.
TSE_JWS_PUBLIC_KEY_B64 = ""
